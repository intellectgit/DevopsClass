environment {
 ecrCredentials : 'us-east-1:AwsJenkinUser'
 registryurl : "repo url from the ecr/reponame"
 vprofileregistry : "https://repo url from the ecr"
}

pipeline {
    agent any // Uses your Jenkins master/agent setup

    environment {
        // AWS ECR Global Variables provided
        AWS_REGION     = 'us-east-1'
        CREDENTIALS_ID = 'AwsJenkinUser' // ID of your AWS credentials stored in Jenkins
        
        // Split your registry values properly for Docker commands
        REGISTRY_URL   = '666458321751.dkr.ecr.us-east-1.amazonaws.com' // Replace with your actual numeric account ID domain
        REPO_NAME      = 'springboot-docker-demo'
        IMAGE_TAG      = "${env.BUILD_ID}"
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                // Pulls source code and Dockerfile from your GitHub repository
                checkout scm
            }
        }

        stage('2. Build Maven Jar') {
            steps {
                // Compiles the Spring Boot jar locally using Maven container or installed tool
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('3. Build Docker Image') {
            steps {
                script {
                    // Builds the image using your Dockerfile and tags it
                    appImage = docker.build("${env.REPO_NAME}:${env.IMAGE_TAG}")
                }
            }
        }

        stage('4. Push to AWS ECR') {
            steps {
                script {
                    // Authenticates via the Amazon ECR plugin and pushes the image safely
                    docker.withRegistry("https://${env.REGISTRY_URL}", "ecr:${env.AWS_REGION}:${env.CREDENTIALS_ID}") {
                        appImage.push("${env.IMAGE_TAG}")
                        appImage.push("latest") // Optional: also push a 'latest' tag
                    }
                }
            }
        }
    }
    
    post {
        always {
            // Cleanup local images from the agent to save disk space
            sh "docker rmi ${env.REGISTRY_URL}/${env.REPO_NAME}:${env.IMAGE_TAG} || true"
            cleanWs()
        }
    }
}

















